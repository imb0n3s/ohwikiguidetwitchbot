# ---- Twitch developer app (dev.twitch.tv/console/apps) ----
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Public URL of this server, no trailing slash. Must match the OAuth Redirect URL
# in your Twitch app: <BASE_URL>/auth/callback
BASE_URL=https://ohwikibot.up.railway.app

# ---- Answer engine ----
# free   = no AI, no per-question cost: best matching wiki page + relevant lines + link (default)
# claude = AI-written answers from the wiki text (~half a cent per question, needs ANTHROPIC_API_KEY)
ANSWER_MODE=free
# Only needed for ANSWER_MODE=claude (console.anthropic.com/settings/keys)
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# ---- Secrets you make up (long random strings) ----
# ADMIN_KEY unlocks /setup and /admin. SESSION_SECRET signs login state.
ADMIN_KEY=
SESSION_SECRET=

# ---- Where the SQLite database lives. On Railway, mount a volume here. ----
DATA_DIR=/data

# ---- Optional ----
# PORT=3000
# BOT_NAME=OH Wiki Bot
# WIKI_BASE=https://ohwikiguide.com
# COMMANDS=!ask,!wiki
# USER_COOLDOWN_SECONDS=20
# CHANNEL_COOLDOWN_SECONDS=3
# MAX_CONCURRENT_ANSWERS=8
# MAX_ANSWER_CHARS=380
# TERMS_URL=https://ohwikiguide.com/OH_Wiki_Bot_Terms_of_Service
# PRIVACY_URL=https://ohwikiguide.com/Privacy_Policy
# DISCORD_URL=
